# ─────────────────────────────────────────────────────────────────────────────
# FNOL Claims-Triage Copilot — environment template  (NFR-01)
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# --- Model provider: Google Gemini is the ONLY approved provider (Rule R4) ---
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.1
# Client-side pacing (requests/minute per model) — stays under the free-tier quota
GEMINI_RPM=12

# --- Cost basis for the golden-signals report (AC-09), USD per 1K tokens ---
# gemini-3.5-flash-lite list price ($0.30 / $2.50 per 1M tokens, genai-prices, 2026-09-18)
PRICE_PER_1K_INPUT=0.00030
PRICE_PER_1K_OUTPUT=0.00250

# --- Triage thresholds (SPEC-02 §2.5) — currency is INR ---
FAST_TRACK_MAX_AMOUNT=50000
HIGH_VALUE_THRESHOLD=500000
INVESTIGATE_MIN_INDICATORS=3
FRAUD_MEDIUM_SCORE=0.35
FRAUD_HIGH_SCORE=0.65

# --- Graph limits (SPEC-02 §3.2) ---
MAX_STEPS=25
MAX_RAG_HOPS=3
CONTEXT_BUDGET_TOKENS=6000

# --- Resilience (NFR-04) ---
TOOL_TIMEOUT_S=20
MODEL_TIMEOUT_S=45
MAX_RETRIES=2

# --- Local storage (all file-based; no external DB service — Rule R4) ---
CHECKPOINT_DB=var/checkpoints.sqlite
MEMORY_DB=var/memory.sqlite
CHROMA_DIR=var/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Observability (Phase 4) ---
PHOENIX_PROJECT_NAME=fnol-triage
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_ENABLED=true

# --- Data generation (Rule R5: deterministic) ---
DATA_SEED=20260918

# DeepEval judge price basis (gemini-3.1-flash-lite, $0.25 / $1.50 per 1M tokens)
JUDGE_PRICE_PER_1K_INPUT=0.00025
JUDGE_PRICE_PER_1K_OUTPUT=0.00150
